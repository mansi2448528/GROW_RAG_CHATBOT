# Provider keys — never commit the real .env
# Copy to .env and fill in: Copy-Item .env.example .env

GROQ_API_KEY=

# Model id is read from here, never hardcoded in config.yaml.
# Set a model that your Groq account can actually serve (see README / architecture §8.2).
LLM_MODEL=

# Optional provider fallbacks (unused unless llm.provider is changed)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
